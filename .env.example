KOTO_ENVIRONMENT=local
# Local access is allowed only on loopback. No Telegram/AI keys needed for this stage.
KOTO_AUTH_MODE=local
# PostgreSQL is the intended runtime. See README for starting it.
KOTO_DATABASE_URL=postgresql+psycopg://kotolancer:local-kotolancer@127.0.0.1:5433/kotolancer
KOTO_STORAGE_DIR=data/files
# Protected mode requires a separately generated 32+ character token.
# KOTO_AUTH_MODE=token
# KOTO_ACCESS_TOKEN=

# Consultant: no live requests until a dedicated key and a model are configured.
# Never send the key in chat or commit it to Git.
KOTO_OPENAI_API_KEY=
KOTO_OPENAI_MODEL=
# Leave empty for model defaults. Confirm supported values for the chosen model.
KOTO_OPENAI_REASONING_EFFORT=
KOTO_OPENAI_DAILY_REQUEST_LIMIT=20
KOTO_OPENAI_MAX_OUTPUT_TOKENS=4000
KOTO_OPENAI_TIMEOUT_SECONDS=120

# Dedicated Telegram bot. Polling is started separately; never reuse another running bot.
KOTO_TELEGRAM_BOT_TOKEN=
KOTO_TELEGRAM_OWNER_ID=0
KOTO_TELEGRAM_AUTH_MAX_AGE=3600
# Set HTTPS URL when deployed, then switch authentication to telegram.
KOTO_MINI_APP_URL=
# Read-only runtime GitHub connector; unrelated to Git publication credentials.
KOTO_GITHUB_TOKEN=
KOTO_GITHUB_OWNER=example-owner
